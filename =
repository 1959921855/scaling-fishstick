# ========== 天气函数 ==========
async def get_weather_tool(city: str, date_type: str = "today") -> str:
    if not city:
        return "请提供城市名"
    try:
        GAODE_API_KEY = os.getenv("GAODE_API_KEY")
        if not GAODE_API_KEY:
            return "天气服务配置错误"
        geo_url = "https://restapi.amap.com/v3/geocode/geo"
        geo_resp = requests.get(geo_url, params={"address": city, "key": GAODE_API_KEY}, timeout=10)
        geo_data = geo_resp.json()
        if geo_data.get("status") != "1" or not geo_data.get("geocodes"):
            return f"未找到城市 {city}"
        adcode = geo_data["geocodes"][0]["adcode"]
        if date_type == "today":
            weather_url = "https://restapi.amap.com/v3/weather/weatherInfo"
            params = {"city": adcode, "key": GAODE_API_KEY, "extensions": "base"}
            resp = requests.get(weather_url, params=params, timeout=10)
            data = resp.json()
            if data.get("status") != "1":
                return f"无法获取 {city} 天气"
            live = data["lives"][0]
            return f"{city} 当前天气：{live['weather']}，气温 {live['temperature']}℃，{live['winddirection']}风 {live['windpower']}级，湿度 {live['humidity']}%。"
        else:
            weather_url = "https://restapi.amap.com/v3/weather/weatherInfo"
            params = {"city": adcode, "key": GAODE_API_KEY, "extensions": "all"}
            resp = requests.get(weather_url, params=params, timeout=10)
            data = resp.json()
            if data.get("status") != "1":
                return f"无法获取 {city} 预报"
            forecasts = data["forecasts"][0]["casts"]
            idx_map = {"tomorrow": 1, "dayafter": 2}
            idx = idx_map.get(date_type, 0)
            day_label = {"tomorrow": "明天", "dayafter": "后天"}.get(date_type, "今天")
            if idx >= len(forecasts):
                return f"无法获取 {city} {day_label} 天气"
            fc = forecasts[idx]
            return f"{city}{day_label}天气：{fc['dayweather']}，白天{fc['daytemp']}℃，夜间{fc['nighttemp']}℃，{fc['daywind']}风{fc['daypower']}级。"
    except Exception as e:
        logger.error(f"天气异常: {e}")
        return "天气服务暂时不可用"

# ========== 工具执行入口 ==========
async def execute_tool(tool_name: str, arguments: dict) -> str:
    logger.info(f"[TOOL_CALL] {tool_name} {arguments}")
    if tool_name == "get_weather":
        return await get_weather_tool(arguments.get("city"), arguments.get("date", "today"))
    elif tool_name == "web_search":
        query = arguments.get("query")
        if not query:
            return "请提供搜索词"
        results = await web_search(query)
        return format_search_results(query, results) if results else f"⚠️ 未找到关于 '{query}' 的信息。"
    elif tool_name == "search_news":
        query = arguments.get("query")
        if not query:
            return "请提供新闻关键词"
        query = remove_date_words(query)
        results = await web_search(f"{query} 新闻", max_results=10)
        return format_news_results(query, results, get_today_str())
    elif tool_name == "get_stock":
        return await get_stock_quote(arguments.get("symbol"), arguments.get("date"))
    return "未知工具"

# ========== 时间函数 ==========
def get_current_time() -> str:
    now = datetime.now(ZoneInfo("Asia/Shanghai"))
    weekdays = ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"]
    hour = now.hour
    am_pm = "上午" if hour < 12 else "下午"
    hour_12 = hour if hour <= 12 else hour - 12
    if hour_12 == 0: hour_12 = 12
    return f"现在是{now.year}年{now.month}月{now.day}日 {am_pm}{hour_12}点{now.minute:02d}分，{weekdays[now.weekday()]}"

def get_relative_date(offset: int) -> str:
    target = datetime.now(ZoneInfo("Asia/Shanghai")) + timedelta(days=offset)
    wd = ["星期一","星期二","星期三","星期四","星期五","星期六","星期日"]
    label = "明天" if offset==1 else "后天" if offset==2 else f"{offset}天后"
    return f"{label}是{target.month}月{target.day}日，{wd[target.weekday()]}"

def get_weekday_of_date(month: int, day: int) -> str:
    try:
        target = datetime.now(ZoneInfo("Asia/Shanghai")).replace(month=month, day=day)
        wd = ["星期一","星期二","星期三","星期四","星期五","星期六","星期日"]
        return f"{month}月{day}日是{wd[target.weekday()]}"
    except:
        return f"{month}月{day}日不存在哦"

