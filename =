def clean_region(raw: str) -> str:
    if not raw:
        return ""
    for w in WEATHER_KEYWORDS:
        raw = raw.replace(w, "")
    for word in sorted(EXCLUDE_WORDS, key=len, reverse=True):
        raw = raw.replace(word, "")
    raw = re.sub(r'[^\u4e00-\u9fa5]', '', raw)
    m = re.search(r"([\u4e00-\u9fa5]{2,})", raw)
    return m.group(1) if m else ""

def extract_region_and_date(text: str):
    date_map = {"今天":"today","明天":"tomorrow","后天":"dayafter","明日":"tomorrow"}
    date_type = None
    for kw, dt in date_map.items():
        if kw in text:
            date_type = dt
            break
    clean = text
    for kw in date_map:
        clean = clean.replace(kw, "")
    m = re.search(r"([\u4e00-\u9fa5]{2,})", clean)
    region = m.group(1) if m else None
    if region and (region in EXCLUDE_WORDS or len(region) < 2):
        region = None
    return region, date_type

async def get_temperature_for_date(city: str, date_type: str, temp_type: str) -> str:
    result = await execute_tool("get_weather", {"city": city, "date": date_type})
    day_label_map = {"today": "今天", "tomorrow": "明天", "dayafter": "后天"}
    day_label = day_label_map.get(date_type, "今天")
    if temp_type == "max":
        match = re.search(r"白天(\d+)℃", result)
        if match:
            return f"{city}{day_label}的最高温度是 {match.group(1)}℃。"
    elif temp_type == "min":
        match = re.search(r"夜间(\d+)℃", result)
        if match:
            return f"{city}{day_label}的最低温度是 {match.group(1)}℃。"
    return result

async def implicit_tool_call(user_msg: str) -> tuple[bool, str | None]:
    now = datetime.now(ZoneInfo("Asia/Shanghai"))
    weekdays = ["星期一","星期二","星期三","星期四","星期五","星期六","星期日"]
    
    # 年份、月份
    if any(k in user_msg for k in ["哪一年","今年哪一年","年份"]):
        return True, f"今年是{now.year}年。"
    if any(k in user_msg for k in ["几月","月份"]):
        return True, f"现在是{now.month}月。"
    
    # 具体日期
    match = re.search(r"(\d{1,2})\s*[月\.]\s*(\d{1,2})\s*.*?(?:星期|周)", user_msg)
    if match:
        return True, get_weekday_of_date(int(match.group(1)), int(match.group(2)))

    # 时间
    if any(k in user_msg for k in ["几点","时间","日期","星期几","几号","周几"]):
        if "明天" in user_msg:
            return True, get_relative_date(1)
        elif "后天" in user_msg:
            return True, get_relative_date(2)
        else:
            return True, get_current_time()

    # 天气
    if any(k in user_msg for k in WEATHER_KEYWORDS):
        raw_reg, date_type = extract_region_and_date(user_msg)
        region = clean_region(raw_reg) if raw_reg else "南京"
        date_type = date_type or "today"
        return True, await get_weather_tool(region, date_type)

    # 新闻
    if "新闻" in user_msg:
        query = re.sub(r'(新闻|资讯|报道)', '', user_msg).strip()
        city = next((c for c in ["南京","北京","上海","广州","深圳","杭州","成都","武汉","西安","苏州","天津","重庆"] if c in user_msg), None)
        query = city or query or "今日热点"
        return True, await execute_tool("search_news", {"query": query})

    # 股票
    if re.search(r"股票|股价|行情|大盘|指数|A股|走势|上证|深证|创业板", user_msg):
        symbol = re.search(r"(上证指数|深证成指|创业板指|大盘|A股走势|股市走势|纳斯达克|道琼斯)", user_msg)
        if symbol:
            sym = symbol.group(1)
            sym = "上证指数" if sym in ("大盘","A股走势","股市走势") else sym
            return True, await execute_tool("get_stock", {"symbol": sym})
        m = re.search(r"([A-Z0-9\u4e00-\u9fa5]+)(?:股票|股价|行情)", user_msg)
        if m:
            symbol = m.group(1).strip()
        else:
            m = re.search(r"(?:股票|股价|行情)[：:]*\s*([A-Z0-9\u4e00-\u9fa5]+)", user_msg)
            if m:
                symbol = m.group(1).strip()
            else:
                words = user_msg.split()
                symbol = next((w for w in reversed(words) if w not in ["股票","股价","行情","查","一下","什么"]), None)
        if symbol:
            return True, await execute_tool("get_stock", {"symbol": symbol})

    # 通用搜索
    if re.search(r"搜索|查一下|搜一下|百度", user_msg):
        query = re.sub(r"(搜索|查一下|搜一下|百度)\s*", "", user_msg).strip()
        if query:
            return True, await execute_tool("web_search", {"query": query})

    return False, None

