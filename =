# ========== 通用搜索（自动读取 HTTPS_PROXY 环境变量） ==========
async def web_search(query: str, max_results: int = 8) -> List[tuple]:
    from ddgs import DDGS
    # 读取超时设置
    timeout = int(os.getenv("DDGS_TIMEOUT", 12))
    try:
        # 不传 proxies，完全依赖环境变量 HTTP_PROXY / HTTPS_PROXY / ALL_PROXY
        with DDGS(timeout=timeout) as ddgs:
            raw = list(ddgs.text(query, max_results=max_results))
    except Exception as e:
        logger.error(f"搜索失败: {e}")
        return []

    spam_domains = [
        "qindh.com", "bing.com", "microsoft.com", "yahoo.com", "baidu.com",
        "so.com", "sogou.com", "doubao.com", "yidianzixun.com", "zhihu.com",
        "taobao.com", "jd.com", "pinduoduo.com"
    ]
    clean = []
    for r in raw:
        href = r.get('href', '')
        title = r.get('title', '')
        body = r.get('body', '')
        if any(d in href for d in spam_domains):
            continue
        if len(body) < 30 or len(title) < 5:
            continue
        if "首页" in title and "新闻" not in title:
            continue
        clean.append((title, body, href))
    return clean

def format_search_results(query: str, results: List[tuple]) -> str:
    if not results:
        return f"⚠️ 未找到关于“{query}”的信息。"
    lines = [f"🔍 搜索“{query}”结果："]
    for idx, (title, body, link) in enumerate(results[:5], 1):
        lines.append(f"{idx}. {title}")
        lines.append(f"   {body[:120]}...")
    return "\n".join(lines)

def format_news_results(query: str, results: List[tuple], today: str) -> str:
    if not results:
        return f"📰 未找到关于“{query}”的最新新闻。"
    seen = set()
    unique = []
    for t, b, l in results:
        if t not in seen:
            seen.add(t)
            unique.append((t, b, l))
    recent, others = [], []
    for item in unique:
        if today in item[0] + item[1] or "今天" in item[0] + item[1]:
            recent.append(item)
        else:
            others.append(item)
    final = (recent + others)[:6]
    lines = [f"📰 {today} 关于“{query}”的新闻："]
    for idx, (title, body, link) in enumerate(final, 1):
        lines.append(f"{idx}. {title}")
        clean_body = re.sub(r'[\\*]', '', body)[:100].strip()
        if clean_body:
            lines.append(f"   {clean_body}")
    return "\n".join(lines)

