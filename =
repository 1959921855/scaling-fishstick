# ---------- 辅助函数 ----------
def split_into_chunks(text: str, chunk_size: int = 600) -> List[str]:
    if len(text) <= chunk_size:
        return [text]
    chunks = []
    entries = text.split('\n\n')
    current = ""
    for entry in entries:
        if len(current) + len(entry) + 2 <= chunk_size:
            current += (entry + "\n\n")
        else:
            if current:
                chunks.append(current.strip())
            current = entry + "\n\n"
    if current:
        chunks.append(current.strip())
    return chunks

def remove_date_words(text: str) -> str:
    date_words = ["今天", "明天", "后天", "昨日", "明日", "前天"]
    for w in date_words:
        text = text.replace(w, "")
    return text.strip()

